{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "tech-genus/tg-pay-php-client",
    "description": "Laravel client for tg-pay payment API",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "payment", "tg-pay", "gateway", "subscription", "checkout"],
    "authors": [
        {
            "name": "Tech Genus",
            "email": "contato@techgenus.com.br"
        }
    ],
    "homepage": "https://github.com/RenatoVi/tg-pay-client",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "TechGenus\\TgPay\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "TechGenus\\TgPay\\TgPayServiceProvider"
            ],
            "aliases": {
                "TgPay": "TechGenus\\TgPay\\Facade\\TgPay"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
